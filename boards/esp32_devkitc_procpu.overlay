#include <zephyr/dt-bindings/pinctrl/esp32-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		led0 = &user_led_pwm;
		button0 = &button0;
	};

	pwmleds {
		compatible = "pwm-leds";

		user_led_pwm: led0 {
        pwms = <&ledc0 1 200000 PWM_POLARITY_INVERTED>;
			label = "USER_LED_PWM";
		};
	};

	gpio_keys: buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			label = "button";
		};
	};
};

&ledc0 {
    status = "okay";

    pinctrl-names = "default";
    pinctrl-0 = <&ledc0_custom>;

    #address-cells = <1>;
    #size-cells = <0>;

    channel1@1 {
        reg = <0x1>;
        timer = <0>;
        status = "okay";
    };
};

&pinctrl {
    ledc0_custom: ledc0_custom {
        group1 {
            pinmux = <LEDC_CH1_GPIO2>;
            output-enable;
        };
    };
};
